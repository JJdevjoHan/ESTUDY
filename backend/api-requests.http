### VS Code "REST Client" extension. Start the backend first, then click "Send Request".
### Login requests save the token automatically in the variable used by the others.

@baseUrl = http://localhost:8080/api


### ===================== PUBLIC =====================

### Register a student (role: student or teacher)
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "role": "student",
  "fullName": "Ana Reyes",
  "email": "ana@school.edu",
  "schoolId": "2024-0002",
  "password": "Student123"
}

### Login as the student (email OR school ID works in "email")
# @name loginStudent
POST {{baseUrl}}/auth/login
Content-Type: application/json

{ "email": "ana@school.edu", "password": "Student123", "rememberMe": false }

### Login as the seeded admin
# @name loginAdmin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{ "email": "admin@estudy.local", "password": "Admin12345" }

@studentToken = {{loginStudent.response.body.$.token}}
@adminToken = {{loginAdmin.response.body.$.token}}


### ===================== ANY LOGGED-IN USER =====================

### View own profile
GET {{baseUrl}}/users/me
Authorization: Bearer {{studentToken}}

### Update own profile
PUT {{baseUrl}}/users/me
Authorization: Bearer {{studentToken}}
Content-Type: application/json

{ "fName": "Ana", "lName": "Reyes", "email": "ana@school.edu", "yearLevel": "2nd Year", "section": "BSIT-2A" }

### Change own password
PUT {{baseUrl}}/users/me/password
Authorization: Bearer {{studentToken}}
Content-Type: application/json

{ "currentPassword": "Student123", "newPassword": "Student456" }

### Logout (the frontend then deletes its token)
POST {{baseUrl}}/auth/logout
Authorization: Bearer {{studentToken}}


### ===================== ROLE SEPARATION =====================

### 200 for a student, 403 for everyone else
GET {{baseUrl}}/student/home
Authorization: Bearer {{studentToken}}

### 403: a student must not reach the teacher area
GET {{baseUrl}}/teacher/home
Authorization: Bearer {{studentToken}}

### 401: no token
GET {{baseUrl}}/users/me


### ===================== ADMIN ONLY =====================

### List all accounts (optional ?role=student|teacher|admin)
GET {{baseUrl}}/admin/users
Authorization: Bearer {{adminToken}}

### Get one account
GET {{baseUrl}}/admin/users/2
Authorization: Bearer {{adminToken}}

### Create an account (any role, including admin)
POST {{baseUrl}}/admin/users
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{ "role": "teacher", "fName": "Maria", "lName": "Santos", "email": "maria@school.edu", "username": "T-1001", "password": "Teacher123" }

### Edit an account (admins may also change username / accessLevel)
PUT {{baseUrl}}/admin/users/2
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{ "fName": "Ana", "lName": "Reyes", "email": "ana@school.edu", "username": "2024-0002", "section": "BSIT-2B" }

### Assign a role
PUT {{baseUrl}}/admin/users/2/role
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{ "role": "teacher" }

### Disable / enable an account
PUT {{baseUrl}}/admin/users/2/status
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{ "enabled": false }

### Reset someone's password
PUT {{baseUrl}}/admin/users/2/password
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{ "newPassword": "NewPass123" }

### Delete an account
DELETE {{baseUrl}}/admin/users/2
Authorization: Bearer {{adminToken}}

### List the roles with user counts
GET {{baseUrl}}/admin/roles
Authorization: Bearer {{adminToken}}
